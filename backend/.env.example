# Copy to .env (this file is git-ignored). Never commit real values.
MONGO_URI=mongodb://localhost:27017/mushtech
PORT=4000
# Allowed website origins, comma separated, no trailing slash
CORS_ORIGIN=http://localhost:3000
# Random string, at least 32 chars:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1d
# On first start the API creates this admin login (if missing) and the launch products (if none exist).
# Set AUTO_SEED=false to turn that off.
# Lost the admin password, or want to promote a registered account? Set ADMIN_EMAIL, ADMIN_PASSWORD and
# ADMIN_FORCE_RESET=true for one start, then remove ADMIN_FORCE_RESET.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: shop timezone offset from UTC in minutes (e.g. 180) so dashboard "today" matches local time
SHOP_UTC_OFFSET_MINUTES=0
