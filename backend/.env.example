# Copy to .env (this file is git-ignored). Never commit real values.
MONGO_URI=mongodb://localhost:27017/mushtech
PORT=4000
# Allowed website origins, comma separated, no trailing slash
CORS_ORIGIN=http://localhost:3000
# Random string, at least 32 chars:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Used only by "npm run seed" to create the admin login
ADMIN_EMAIL=
ADMIN_PASSWORD=
