# Used by docker compose (copy to .env, which is git-ignored)
WEB_PORT=3002
API_PORT=4000
# Secret for signing login tokens, 32+ characters (openssl rand -hex 32)
JWT_SECRET=
# Admin login created by: docker compose --profile seed run --rm --build seed
# Avoid the $ character in the password (compose treats it specially)
ADMIN_EMAIL=
ADMIN_PASSWORD=
